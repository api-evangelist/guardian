{
  "opencollection": "1.0.0",
  "info": {
    "name": "The Guardian Content Tags API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api-key",
      "value": "{{api-key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search for tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://content.guardianapis.com/tags",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search query for tag names"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by tag type"
              },
              {
                "name": "section",
                "value": "",
                "type": "query",
                "description": "Filter tags by section"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "page-size",
                "value": "",
                "type": "query",
                "description": "Results per page"
              }
            ]
          },
          "docs": "Search for tags (keywords, series, contributors, blogs, etc.). Tags are used to classify content and can be used for filtering in the search endpoint."
        }
      ]
    }
  ],
  "bundled": true
}