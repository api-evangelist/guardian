        {
          "id": "0bf3dfc2-e657-4d0c-beeb-f7b4accc2db3",
          "name": "Search for content",
          "request": {
            "name": "Search for content",
            "description": {
              "content": "Search all Guardian content. Returns articles, liveblogs, galleries, and other content types matching the query. Results are paginated and can be filtered by section, tag, date range, and more.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Full-text search query. Supports AND, OR, NOT operators."
                },
                {
                  "disabled": false,
                  "key": "query-fields",
                  "value": "<string>",
                  "description": "Specify which indexed fields are used by the q parameter (e.g., headline, body, all)"
                },
                {
                  "disabled": false,
                  "key": "section",
                  "value": "<string>",
                  "description": "Filter by section ID (e.g., technology, sport). Use | for OR, - prefix to exclude."
                },
                {
                  "disabled": false,
                  "key": "tag",
                  "value": "<string>",
                  "description": "Filter by tag ID (e.g., technology/apple). Use comma for AND, | for OR, - to exclude."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filter by content type"
                },
                {
                  "disabled": false,
                  "key": "from-date",
                  "value": "<date>",
                  "description": "Return content published on or after this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "to-date",
                  "value": "<date>",
                  "description": "Return content published on or before this date (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "order-by",
                  "value": "relevance",
                  "description": "Sort order for results"
                },
                {
                  "disabled": false,
                  "key": "show-fields",
                  "value": "<string>",
                  "description": "Comma-separated list of article fields to include (e.g., body,headline,thumbnail,shortUrl,byline,trailText,wordcount,starRating,all)"
                },
                {
                  "disabled": false,
                  "key": "show-tags",
                  "value": "<string>",
                  "description": "Comma-separated list of tag types to include (e.g., keyword,contributor,series,blog,tone,type,all)"
                },
                {
                  "disabled": false,
                  "key": "show-elements",
                  "value": "<string>",
                  "description": "Include media elements (image, video, audio, all)"
                },
                {
                  "disabled": false,
                  "key": "show-blocks",
                  "value": "<string>",
                  "description": "Include block-level content (body, all, main)"
                },
                {
                  "disabled": false,
                  "key": "show-references",
                  "value": "<string>",
                  "description": "Include references"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination"
                },
                {
                  "disabled": false,
                  "key": "page-size",
                  "value": "10",
                  "description": "Number of results per page (max 50 for free tier)"
                },
                {
                  "disabled": false,
                  "key": "use-date",
                  "value": "<string>",
                  "description": "Which date to use for filtering and ordering"
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "ISO language code to filter content by language"
                },
                {
                  "disabled": false,
                  "key": "star-rating",
                  "value": "<integer>",
                  "description": "Filter by star rating (for reviews)"
                },
                {
                  "disabled": false,
                  "key": "production-office",
                  "value": "<string>",
                  "description": "Filter by production office"
                }
              ],
              "variable": []
            },
